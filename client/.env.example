# =================================================================
# ResQ Frontend - Environment Configuration (.env.example)
# =================================================================
# In local development: leave blank to automatically use Vite proxy (/api -> localhost:5000)
#
# In production on Render (or Vercel / Netlify):
# Set this to your deployed Render backend web service URL (without trailing /api)
# Example: https://resq-backend.onrender.com
VITE_API_BASE_URL=https://resq-backend.onrender.com

# Optional: Real-time Socket.IO Server URL
# Automatically defaults to the host from VITE_API_BASE_URL if left empty
VITE_SOCKET_URL=https://resq-backend.onrender.com
