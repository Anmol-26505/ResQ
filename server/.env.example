# =================================================================
# ResQ Backend - Production Environment Variables (.env.example)
# =================================================================
# Configure these variables in your Render Web Service Dashboard
# (Render Dashboard -> Your Backend Web Service -> Environment -> Environment Variables)

# Node.js Environment mode ('production' on Render, 'development' locally)
NODE_ENV=production

# Server Port (Render automatically sets this in production, defaults to 5000 locally)
PORT=5000

# MongoDB Atlas Connection URI (REQUIRED for Render deployment)
# Get this from MongoDB Atlas -> Database -> Connect -> Connect your application (Drivers)
# Example: mongodb+srv://resq_admin:YourStrongPassword@resq-cluster.abcde.mongodb.net/resq?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resq?retryWrites=true&w=majority

# JWT Authentication Secret Key (REQUIRED: Use a strong, random 32+ character string)
JWT_SECRET=resq_production_jwt_secret_key_change_me_to_a_random_32_char_string

# JWT Expiration Period (e.g. 7d, 24h)
JWT_EXPIRE=7d

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# Add your deployed Render/Vercel/Netlify frontend URL, e.g. https://resq-frontend.onrender.com
# Also include localhost origins if testing locally against the deployed backend
CORS_ORIGIN=https://resq-frontend.onrender.com,http://localhost:5173,http://localhost:3000

# Optional frontend URL alias
CLIENT_URL=https://resq-frontend.onrender.com

# Device Inactivity Timeout (milliseconds before marking inactive devices as 'offline')
# Default: 60000 (1 minute)
DEVICE_OFFLINE_THRESHOLD_MS=60000

# Automatic Background Telemetry Simulator
# Set to 'false' in production so actual physical NodeMCU / ESP8266 telemetry drives the system
AUTO_SIMULATION=false
