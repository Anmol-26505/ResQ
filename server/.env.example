# ResQ Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/resq?retryWrites=true&w=majority)
# Leave blank or omit in development to automatically use the embedded in-memory MongoDB instance
MONGODB_URI=

# JWT Secret for user session tokens
JWT_SECRET=resq_emergency_iot_jwt_super_secret_key_2026

# JWT Expiration (e.g. 1d, 7d)
JWT_EXPIRE=7d

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Device heartbeat timeout in milliseconds before marking offline (default: 60000ms = 1 min)
DEVICE_OFFLINE_THRESHOLD_MS=60000

# Automatic background simulation toggle (true/false)
AUTO_SIMULATION=false
