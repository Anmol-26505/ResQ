# =================================================================
# ResQ Backend - Production Environment Variables (.env.example)
# =================================================================
# Configure these variables in your Render Web Service Dashboard:
# (Render Dashboard -> Your Backend Web Service -> Environment -> Environment Variables)

# Node.js Environment mode ('production' on Render, 'development' locally)
NODE_ENV=production

# Server Port (Render automatically sets this in production, defaults to 5000 locally)
PORT=5000

# MongoDB Atlas Connection URI (REQUIRED for Render deployment)
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://resq_admin:YourStrongPassword@cluster0.abcde.mongodb.net/resq?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resq?retryWrites=true&w=majority

# JWT Authentication Secret Key (REQUIRED: 32+ character random string)
JWT_SECRET=resq_production_jwt_secret_key_change_me_to_a_random_32_char_string

# JWT Expiration Period (e.g. 7d, 24h)
JWT_EXPIRE=7d

# Device Ingestion API Key (REQUIRED for hardware telemetry security)
# NodeMCU ESP8266 must send this in the 'x-api-key' HTTP header when posting to /api/sensors/update
DEVICE_API_KEY=resq_iot_secure_key_2026

# Telegram Emergency Bot Notifications (Optional but recommended)
# Get TELEGRAM_BOT_TOKEN from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Get TELEGRAM_CHAT_ID from @userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_numeric

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
CORS_ORIGIN=https://resq-8tbc.onrender.com,http://localhost:5173,http://localhost:3000

# Frontend URL
CLIENT_URL=https://resq-8tbc.onrender.com

# Device Inactivity Timeout (milliseconds before marking inactive devices as 'offline')
DEVICE_OFFLINE_THRESHOLD_MS=60000

# Automatic Background Telemetry Simulator ('false' when using physical ESP8266 hardware)
AUTO_SIMULATION=false
